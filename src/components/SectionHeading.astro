---
type Props = {
  label: string;
  title: string;
  eyebrow?: string;
  id?: string;
};

const { label, title, eyebrow, id } = Astro.props as Props;
---

<header class="section-heading">
  <p class="section-label">{label}</p>
  <div>
    <h2 class="section-title" id={id}>{title}</h2>
    {eyebrow ? <p class="eyebrow">{eyebrow}</p> : null}
  </div>
</header>

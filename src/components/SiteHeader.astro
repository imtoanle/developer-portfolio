---
import { site } from '../lib/site';

const currentPath = Astro.url.pathname;

const links = [
  ['/', 'Home'],
  ['/work', 'Work'],
  ['/notes', 'Notes'],
  ['/about', 'About'],
  ['/cv', 'CV'],
  ['/contact', 'Contact'],
] as const;

const isCurrent = (href: string) => {
  if (href === '/') {
    return currentPath === '/';
  }

  if (href === '/work') {
    return currentPath.startsWith('/work');
  }

  if (href === '/notes') {
    return currentPath.startsWith('/notes');
  }

  return currentPath === href;
};
---

<header class="site-header">
  <a class="site-brand" href="/">
    <span class="brand-mark" aria-hidden="true">TL</span>
    <span>{site.name}</span>
  </a>
  <nav aria-label="Primary">
    <ul class="site-nav">
      {
        links.map(([href, label]) => (
          <li>
            <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>
              {label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
